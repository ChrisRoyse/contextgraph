# marketing-fleet environment template
# Copy to .env.local and fill in values. NEVER commit .env.local.
# Production should use Infisical; this file is build/test only.

# Anthropic API
ANTHROPIC_API_KEY=

# Slack (per 13_AUTONOMOUS_OPERATOR_INTERFACE.md)
SLACK_WORKSPACE_ID=
SLACK_OPERATOR_ASK_CHANNEL=
SLACK_WORKSPACE_URL=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Build mode (build | prod)
BUILD_MODE=build

# Leapable MCP endpoint
LEAPABLE_MCP_URL=

# RocksDB primary instance path
ROCKSDB_PATH=~/.marketing-fleet/db
