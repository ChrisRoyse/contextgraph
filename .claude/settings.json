{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "defaultMode": "acceptEdits",
  "enableAllProjectMcpServers": true,
  "includeCoAuthoredBy": true,
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "LS",
      "WebFetch",
      "WebSearch",
      "TodoWrite",
      "Task",
      "Agent",
      "Edit(crates/context-graph-cli/src/**)",
      "Edit(crates/context-graph-mcp/src/handlers/tools/reality_loop/**)",
      "Edit(scripts/cc/**)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/loop.md)",
      "Edit(.claude/agents/cc-reality-*.md)",
      "Edit(.claude/skills/ccreality-*/**)",
      "Edit(.mcp.json)",
      "Edit(docs/ccreality/**)",
      "Edit(docs/reality/**)",
      "Write(scripts/cc/**)",
      "Write(.claude/settings.json)",
      "Write(.claude/agents/cc-reality-*.md)",
      "Write(.claude/skills/ccreality-*/**)",
      "Write(.mcp.json)",
      "Write(docs/ccreality/**)",
      "Write(docs/reality/**)",
      "Bash(cargo fmt *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo build *)",
      "Bash(cargo clippy *)",
      "Bash(rustfmt *)",
      "Bash(rg *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(git push origin)",
      "Bash(nvidia-smi*)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sha256sum *)",
      "Bash(sudo *)",
      "Bash(apt *)",
      "Bash(apt-get *)",
      "Bash(apt-cache *)",
      "Bash(dpkg *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(echo *)",
      "Bash(stat *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(free *)",
      "Bash(pgrep *)",
      "Bash(pkill *)",
      "Bash(kill *)",
      "Bash(ps *)",
      "Bash(top *)",
      "Bash(nvcc *)",
      "Bash(ldd *)",
      "Bash(strings *)",
      "Bash(file *)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(mkdir *)",
      "Bash(chmod *)",
      "Bash(time *)",
      "Bash(timeout *)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv *)",
      "Bash(which *)",
      "Bash(whereis *)",
      "Bash(uname *)",
      "Bash(systemctl status *)",
      "Bash(journalctl *)",
      "Bash(update-alternatives *)",
      "Bash(huggingface-cli *)",
      "Bash(python3 *)",
      "Bash(bash -n *)",
      "mcp__cgreality__*"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/cc/hook_session_start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "timeout": 8,
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/cc/hook_user_prompt_submit.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/cc/hook_pre_tool_use_edit.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "timeout": 90,
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/cc/hook_post_tool_use_edit.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "timeout": 8,
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/cc/hook_pre_compact.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/cc/hook_stop.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "CONTEXTGRAPH_ROOT": "/home/cabdru/contextgraph",
    "CGREALITY_GOVERNED_PATHS": "/home/cabdru/contextgraph/config/ccreality_governed_paths.json",
    "CGREALITY_RECOMMENDATION_SCHEMA": "/home/cabdru/contextgraph/config/ccreality_recommendation_schema.json"
  }
}
