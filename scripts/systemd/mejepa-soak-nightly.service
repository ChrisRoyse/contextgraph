[Unit]
Description=ContextGraph ME-JEPA nightly accelerated soak FSV
Documentation=file:/home/cabdru/contextgraph/docs/futurebuild/18_INTEGRATION_AND_E2E_TESTING.md
ConditionPathExists=/zfs/archive/contextgraph/fsv
ConditionPathExists=/home/cabdru/contextgraph/target/release/examples/phase_f_soak_test_fsv

[Service]
Type=oneshot
UMask=0077
WorkingDirectory=/home/cabdru/contextgraph
Environment=MEJEPA_SOAK_DURATION_MINS=30
Environment=MEJEPA_SOAK_CYCLES=2
ExecStart=/home/cabdru/contextgraph/target/release/examples/phase_f_soak_test_fsv
SuccessExitStatus=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
